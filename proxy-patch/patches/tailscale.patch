+func TestProxyWebsocketCancellationPhases(t *testing.T) {
+	for _, phase := range []string{"proxy_dial", "proxy_tls", "connect", "relay_tls", "upgrade", "greeting_deadline", "client_close", "invalid_greeting"} {
+		t.Run(phase, func(t *testing.T) {
+			if isolatedProxyTest(t) {
+				return
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), 300*time.Millisecond)
+			defer cancel()
+			switch phase {
+			case "proxy_dial", "proxy_tls", "connect", "relay_tls":
+				accepted := make(chan net.Conn, 1)
+				ln, err := net.Listen("tcp", "127.0.0.1:0")
+				proxyMust(t, err)
+				defer ln.Close()
+				go func() {
+					conn, err := ln.Accept()
+					if err == nil {
+						accepted <- conn
+					}
+				}()
+				proxyScheme := "http"
+				if phase == "proxy_tls" {
+					proxyScheme = "https"
+				}
+				t.Setenv("HTTPS_PROXY", proxyScheme+"://"+ln.Addr().String())
+				tr, err := websocketTransport(ctx, "https://relay.test/derp", nil)
+				proxyMust(t, err)
+				if phase == "proxy_dial" {
+					tr.DialContext = func(ctx context.Context, _, _ string) (net.Conn, error) { <-ctx.Done(); return nil, ctx.Err() }
+				} else if phase == "relay_tls" {
+					peerClosed := make(chan error, 1)
+					go func() {
+						conn := <-accepted
+						defer conn.Close()
+						_ = conn.SetReadDeadline(time.Now().Add(2 * time.Second))
+						r := bufio.NewReader(conn)
+						_, _ = http.ReadRequest(r)
+						_, _ = io.WriteString(conn, "HTTP/1.1 200 Connection Established\r\n\r\n")
+						_, err := io.Copy(io.Discard, conn)
+						peerClosed <- err
+					}()
+					defer func() {
+						select {
+						case err := <-peerClosed:
+							var ne net.Error
+							if errors.As(err, &ne) && ne.Timeout() {
+								t.Error("cancellation left relay TLS socket open")
+							}
+						case <-time.After(time.Second):
+							t.Error("cancellation did not close relay TLS socket")
+						}
+					}()
+				}
+				_, err = dialWebsocketTransport(ctx, "https://relay.test/derp", nil, tr)
+				if !errors.Is(err, context.DeadlineExceeded) {
+					t.Error("connection phase ignored deadline")
+				}
+				if phase != "proxy_dial" && phase != "relay_tls" {
+					select {
+					case conn := <-accepted:
+						_ = conn.SetReadDeadline(time.Now().Add(time.Second))
+						_, err := io.Copy(io.Discard, conn)
+						var ne net.Error
+						if errors.As(err, &ne) && ne.Timeout() {
+							t.Error("cancellation left proxy socket open")
+						}
+						conn.Close()
+					case <-time.After(time.Second):
+						t.Error("fixture connection missing")
+					}
+				}
+			default:
+				opened := make(chan *websocket.Conn, 1)
+				peerClosed := make(chan error, 1)
+				relay := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+					if phase == "upgrade" {
+						<-r.Context().Done()
+						peerClosed <- nil
+						return
+					}
+					ws, err := websocket.Accept(w, r, nil)
+					if err == nil {
+						defer ws.CloseNow()
+						opened <- ws
+						if phase == "invalid_greeting" {
+							_ = ws.Close(websocket.StatusPolicyViolation, "fixture-secret-close-reason")
+						}
+						peerCtx, peerCancel := context.WithTimeout(context.Background(), 2*time.Second)
+						defer peerCancel()
+						_, _, err := ws.Read(peerCtx)
+						peerClosed <- err
+					}
+				}))
+				defer relay.Close()
+				c, err := NewClient(key.NewNode(), relay.URL, func(string, ...any) {})
+				proxyMust(t, err)
+				c.ForceWebsockets = true
+				c.TLSConfig = relay.Client().Transport.(*http.Transport).TLSClientConfig.Clone()
+				done := make(chan error, 1)
+				go func() { done <- c.Connect(ctx) }()
+				if phase != "upgrade" {
+					select {
+					case ws := <-opened:
+						defer ws.CloseNow()
+					case <-time.After(2 * time.Second):
+						t.Fatal("fixture failed to upgrade")
+					}
+				}
+				if phase == "client_close" {
+					_ = c.Close()
+				}
+				select {
+				case err := <-done:
+					if err == nil || strings.Contains(err.Error(), "fixture-secret") {
+						t.Error("failed greeting accepted or secret disclosed")
+					}
+					if phase != "invalid_greeting" && phase != "client_close" && !errors.Is(err, context.DeadlineExceeded) {
+						t.Error("greeting deadline identity lost")
+					}
+				case <-time.After(2 * time.Second):
+					t.Error("connection establishment was not bounded")
+				}
+				_ = c.Close()
+				select {
+				case err := <-peerClosed:
+					if errors.Is(err, context.DeadlineExceeded) {
+						t.Error("cancellation left upgraded socket open")
+					}
+				case <-time.After(time.Second):
+					t.Error("cancellation did not close upgrade socket")
+				}
+			}
+		})
+	}
+}
