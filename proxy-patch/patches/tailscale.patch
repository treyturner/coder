+func (c *Client) websocketClient(ctx context.Context, conn net.Conn) (client *derp.Client, err error) {
+	closed := make(chan struct{})
+	stop := context.AfterFunc(ctx, func() {
+		conn.Close()
+		close(closed)
+	})
+	var stopped bool
+	stopGuard := func() {
+		if !stopped {
+			stopped = true
+			if !stop() {
+				<-closed
+			}
+		}
+	}
+	defer func() {
+		stopGuard()
+		if err != nil {
+			conn.Close()
+		}
+	}()
+	brw := bufio.NewReadWriter(bufio.NewReader(conn), bufio.NewWriter(conn))
+	client, err = derp.NewClient(c.privateKey, conn, brw, c.logf,
+		derp.MeshKey(c.MeshKey),
+		derp.CanAckPings(c.canAckPings),
+		derp.IsProber(c.IsProber),
+	)
+	if err != nil {
+		return nil, safeConnectError(ctx, "DERP greeting", err)
+	}
+	if c.preferred {
+		if err := client.NotePreferred(true); err != nil {
+			return nil, safeConnectError(ctx, "DERP preferred notification", err)
+		}
+	}
+	stopGuard()
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	return client, nil
+}
+
+// connectionError contains fixed diagnostics and safe context sentinels.
+// Authenticated URLs, remote bodies, and underlying error text are excluded.
+type connectionError struct {
+	stage  string
+	status int
+	kind   string
+	cause  error
+}
+
+func (e *connectionError) Error() string {
+	message := "derphttp: " + e.stage + " failed"
+	if e.status != 0 {
+		message += fmt.Sprintf(" (HTTP %d)", e.status)
+	}
+	if e.kind != "" {
+		message += " (" + e.kind + ")"
+	}
+	if e.cause != nil {
+		message += ": " + e.cause.Error()
+	}
+	return message
+}
+
+func (e *connectionError) Unwrap() error { return e.cause }
+
+func safeConnectError(ctx context.Context, stage string, err error) error {
+	var safe *connectionError
+	if !errors.As(err, &safe) {
+		safe = &connectionError{stage: stage, kind: connectErrorKind(err)}
+	}
+	cause := ctx.Err()
+	if cause == nil {
+		switch {
+		case errors.Is(err, context.Canceled):
+			cause = context.Canceled
+		case errors.Is(err, context.DeadlineExceeded), errors.Is(err, os.ErrDeadlineExceeded):
+			cause = context.DeadlineExceeded
+		}
+	}
+	if cause != nil {
+		copy := *safe
+		copy.cause = cause
+		return &copy
+	}
+	return safe
+}
+
+func connectErrorKind(err error) string {
+	var verification *tls.CertificateVerificationError
+	var authority x509.UnknownAuthorityError
+	var hostname x509.HostnameError
+	var invalid x509.CertificateInvalidError
+	var dns *net.DNSError
+	var network net.Error
+	switch {
+	case errors.As(err, &verification), errors.As(err, &authority), errors.As(err, &hostname), errors.As(err, &invalid):
+		return "TLS verification"
+	case errors.As(err, &dns):
+		return "DNS"
+	case errors.Is(err, syscall.ECONNREFUSED):
+		return "connection refused"
+	case errors.Is(err, os.ErrDeadlineExceeded), errors.Is(err, context.DeadlineExceeded):
+		return "timeout"
+	case errors.As(err, &network) && network.Timeout():
+		return "timeout"
+	default:
+		return ""
+	}
+}
