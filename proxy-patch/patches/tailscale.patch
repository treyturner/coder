+func TestProxyWebsocketDERPFallback(t *testing.T) {
+	for _, name := range []string{"fallback", "forced", "initial_derp"} {
+		t.Run(name, func(t *testing.T) {
+			if isolatedProxyTest(t) {
+				return
+			}
+			forbidOriginDNS(t)
+			var logMu sync.Mutex
+			var logs bytes.Buffer
+			logf := func(format string, args ...any) {
+				logMu.Lock()
+				defer logMu.Unlock()
+				fmt.Fprintf(&logs, format, args...)
+			}
+			s := derp.NewServer(key.NewNode(), func(string, ...any) {})
+			defer s.Close()
+			relay := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.Header.Get("Proxy-Authorization") != "" || r.Header.Get("Coder-Session-Token") != "" || r.Header.Get("X-Fixture-Gateway") != "fixture-secret-gateway" {
+					t.Error("DERP credential separation failed")
+				}
+				if r.Header.Get("Upgrade") != "websocket" {
+					if name == "initial_derp" {
+						Handler(s).ServeHTTP(w, r)
+					} else {
+						w.WriteHeader(http.StatusForbidden)
+						_, _ = io.WriteString(w, "fixture-secret-denial-body")
+					}
+					return
+				}
+				ws, err := websocket.Accept(w, r, &websocket.AcceptOptions{Subprotocols: []string{"derp"}})
+				if err != nil {
+					return
+				}
+				defer ws.CloseNow()
+				nc := websocket.NetConn(context.Background(), ws, websocket.MessageBinary)
+				s.Accept(r.Context(), nc, bufio.NewReadWriter(bufio.NewReader(nc), bufio.NewWriter(nc)), r.RemoteAddr)
+			}))
+			defer relay.Close()
+			proxy, connects := connectProxy(t, relay.Listener.Addr().String(), http.StatusOK, nil)
+			t.Setenv("HTTPS_PROXY", proxy.URL)
+			region := &tailcfg.DERPRegion{RegionID: 1, RegionCode: "fixture", Nodes: []*tailcfg.DERPNode{{Name: "fixture", RegionID: 1, HostName: "example.com"}}}
+			clients := make([]*Client, 2)
+			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+			defer cancel()
+			for i := range clients {
+				c := NewRegionClient(key.NewNode(), logf, nil, func() *tailcfg.DERPRegion { return region })
+				clients[i] = c
+				defer c.Close()
+				c.TLSConfig = relay.Client().Transport.(*http.Transport).TLSClientConfig.Clone()
+				c.Header = http.Header{"X-Fixture-Gateway": []string{"fixture-secret-gateway"}}
+				c.ForceWebsockets = name == "forced"
+				if name == "fallback" {
+					if err := c.Connect(ctx); err == nil {
+						t.Fatal("initial DERP denial was ignored")
+					}
+				}
+				proxyMust(t, c.Connect(ctx))
+				waitConnect(t, c)
+			}
+			cancel()
+			proxyMust(t, clients[0].Send(clients[1].privateKey.Public(), []byte("DERP fixture packet")))
+			m, err := clients[1].Recv()
+			proxyMust(t, err)
+			packet, ok := m.(derp.ReceivedPacket)
+			if !ok || string(packet.Data) != "DERP fixture packet" {
+				t.Fatal("real DERP packet exchange failed")
+			}
+			wantConnects := int32(2)
+			if name == "fallback" {
+				wantConnects = 4
+			}
+			if connects.Load() != wantConnects {
+				t.Fatal("unexpected relay route count")
+			}
+			logMu.Lock()
+			defer logMu.Unlock()
+			if strings.Contains(logs.String(), "fixture-secret") {
+				t.Fatal("DERP diagnostics disclosed a synthetic credential")
+			}
+		})
+	}
