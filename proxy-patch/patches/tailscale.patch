+				auth := &http.Request{Header: http.Header{}}
+				auth.SetBasicAuth("fixture-secret-user", "fixture-secret-password")
+				if r.Host != "relay.test:443" || r.TLS.ServerName != "proxy.test" || len(r.TLS.PeerCertificates) != 0 || r.Header.Get("Proxy-Authorization") != auth.Header.Get("Authorization") || r.Header.Get("X-Fixture-Gateway") != "" {
+					t.Error("proxy identity or credential boundary failed")
+				}
+			}, &tls.Config{Certificates: []tls.Certificate{outerCA.leaf(t, proxyName, false)}, ClientAuth: tls.RequestClientCert, MinVersion: tls.VersionTLS12})
+			_, port, err := net.SplitHostPort(proxy.Listener.Addr().String())
+			proxyMust(t, err)
+			pu := &url.URL{Scheme: "https", Host: net.JoinHostPort("proxy.test", port), User: url.UserPassword("fixture-secret-user", "fixture-secret-password")}
+			t.Setenv("HTTPS_PROXY", pu.String())
+			conf := &tls.Config{ServerName: "relay.test", RootCAs: innerCA.pool, Certificates: []tls.Certificate{innerCA.leaf(t, "client.test", true)}, MinVersion: tls.VersionTLS12}
+			if name == "relay_untrusted" {
+				conf.RootCAs = outerCA.pool
+			}
+			if name == "relay_wrong_name" {
+				conf.ServerName = "wrong.test"
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+			defer cancel()
+			tr, err := websocketTransport(ctx, "https://relay.test/derp", conf)
+			proxyMust(t, err)
+			var dials atomic.Int32
+			tr.DialContext = func(ctx context.Context, network, addr string) (net.Conn, error) {
+				dials.Add(1)
+				if addr != pu.Host {
+					return nil, errors.New("unintended direct address")
+				}
+				return (&net.Dialer{}).DialContext(ctx, network, proxy.Listener.Addr().String())
+			}
+			conn, err := dialWebsocketTransport(ctx, "https://relay.test/derp", http.Header{"X-Fixture-Gateway": []string{"fixture-secret-gateway"}}, tr)
+			if name != "verified" {
+				if err == nil {
+					conn.Close()
+					t.Fatal("invalid TLS accepted")
+				}
+				if strings.Contains(err.Error(), "fixture-secret") || relayRequests.Load() != 0 {
+					t.Fatal("TLS failure disclosed credentials or reached relay HTTP")
+				}
+				return
+			}
+			proxyMust(t, err)
+			defer conn.Close()
+			buf := make([]byte, 8)
+			_, err = io.ReadFull(conn, buf)
+			proxyMust(t, err)
+			if string(buf) != "verified" || dials.Load() != 1 || connects.Load() != 1 {
+				t.Fatal("TLS proxy exchange incomplete")
+			}
+		})
+	}
+}
