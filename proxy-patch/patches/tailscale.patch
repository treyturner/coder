+func TestProxyWebsocketDenied(t *testing.T) {
+	for _, name := range []string{"connect_403", "connect_407", "upgrade_403", "malformed_101", "wrong_subprotocol", "redirect"} {
+		t.Run(name, func(t *testing.T) {
+			if isolatedProxyTest(t) {
+				return
+			}
+			forbidOriginDNS(t)
+			var redirected atomic.Int32
+			target := httptest.NewServer(http.HandlerFunc(func(http.ResponseWriter, *http.Request) { redirected.Add(1) }))
+			defer target.Close()
+			relay := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				switch name {
+				case "wrong_subprotocol":
+					accept := sha1.Sum([]byte(r.Header.Get("Sec-WebSocket-Key") + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"))
+					w.Header().Set("Sec-WebSocket-Accept", base64.StdEncoding.EncodeToString(accept[:]))
+					w.Header().Set("Connection", "Upgrade")
+					w.Header().Set("Upgrade", "websocket")
+					w.Header().Set("Sec-WebSocket-Protocol", "fixture-secret-wrong-protocol")
+					w.WriteHeader(http.StatusSwitchingProtocols)
+				case "malformed_101":
+					w.WriteHeader(http.StatusSwitchingProtocols)
+				case "redirect":
+					w.Header().Set("Location", target.URL)
+					w.WriteHeader(http.StatusFound)
+				default:
+					w.WriteHeader(http.StatusForbidden)
+				}
+				_, _ = io.WriteString(w, "fixture-secret-upgrade-body")
+			}))
+			defer relay.Close()
+			status := http.StatusOK
+			if name == "connect_403" {
+				status = http.StatusForbidden
+			} else if name == "connect_407" {
+				status = http.StatusProxyAuthRequired
+			}
+			proxy, connects := connectProxy(t, relay.Listener.Addr().String(), status, nil)
+			pu, _ := url.Parse(proxy.URL)
+			pu.User = url.UserPassword("fixture-secret-user", "fixture-secret-password")
+			t.Setenv("HTTPS_PROXY", pu.String())
+			conf := relay.Client().Transport.(*http.Transport).TLSClientConfig.Clone()
+			conf.ServerName = "example.com"
+			ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+			defer cancel()
+			conn, err := dialWebsocket(ctx, "https://example.com/derp", conf, http.Header{"X-Fixture-Gateway": []string{"fixture-secret-gateway"}})
+			if err == nil {
+				conn.Close()
+				t.Fatal("denied or malformed upgrade accepted")
+			}
+			if connects.Load() != 1 || redirected.Load() != 0 || strings.Contains(err.Error(), "fixture-secret") {
+				t.Fatal("denial changed route or disclosed a synthetic credential")
+			}
+		})
+	}
+}
