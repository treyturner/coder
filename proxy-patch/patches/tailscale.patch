+// websocketTransport keeps proxy authentication outside the relay TLS tunnel.
+func websocketTransport(ctx context.Context, urlStr string, tlsConfig *tls.Config) (*http.Transport, error) {
+	u, err := url.Parse(urlStr)
+	if err != nil {
+		return nil, safeConnectError(ctx, "WebSocket URL", err)
+	}
+	switch u.Scheme {
+	case "ws":
+		u.Scheme = "http"
+	case "wss":
+		u.Scheme = "https"
+	}
+	proxyURL, err := tshttpproxy.ProxyFromEnvironment((&http.Request{URL: u}).WithContext(ctx))
+	if err != nil {
+		return nil, safeConnectError(ctx, "proxy selection", err)
+	}
+	if proxyURL != nil && proxyURL.Scheme != "http" && proxyURL.Scheme != "https" {
+		return nil, &connectionError{stage: "unsupported proxy scheme"}
+	}
+	tr := &http.Transport{
+		TLSClientConfig:       tlsConfig,
+		Proxy:                 http.ProxyURL(proxyURL),
+		GetProxyConnectHeader: proxyConnectHeaders(tshttpproxy.GetAuthHeader),
+		OnProxyConnectResponse: func(ctx context.Context, _ *url.URL, _ *http.Request, res *http.Response) error {
+			if res.StatusCode != http.StatusOK {
+				return &connectionError{stage: "proxy CONNECT", status: res.StatusCode}
+			}
+			return nil
+		},
+	}
+	if proxyURL == nil || proxyURL.Scheme != "https" {
+		return tr, nil
+	}
+
+	// The relay's verifier, mTLS identity, and key logger must not be used
+	// for the outer TLS connection to a different peer.
+	proxyTLS := &tls.Config{
+		ServerName: proxyURL.Hostname(),
+		MinVersion: tls.VersionTLS12,
+		NextProtos: []string{"http/1.1"},
+	}
+	if tlsConfig != nil && tlsConfig.MinVersion > proxyTLS.MinVersion {
+		proxyTLS.MinVersion = tlsConfig.MinVersion
+	}
+	authority := net.JoinHostPort(proxyURL.Hostname(), firstStr(proxyURL.Port(), "443"))
+	tr.DialTLSContext = func(ctx context.Context, network, addr string) (net.Conn, error) {
+		if addr != authority {
+			return nil, &connectionError{stage: "unexpected proxy authority"}
+		}
+		dial := tr.DialContext
+		if dial == nil {
+			dial = (&net.Dialer{}).DialContext
+		}
+		conn, err := dial(ctx, network, addr)
+		if err != nil {
+			return nil, safeConnectError(ctx, "proxy dial", err)
+		}
+		tc := tls.Client(conn, proxyTLS)
+		if err := tc.HandshakeContext(ctx); err != nil {
+			conn.Close()
+			return nil, safeConnectError(ctx, "proxy TLS", err)
+		}
+		return tc, nil
+	}
+	return tr, nil
+}
+
+func proxyConnectHeaders(auth func(*url.URL) (string, error)) func(context.Context, *url.URL, string) (http.Header, error) {
+	return func(ctx context.Context, proxyURL *url.URL, _ string) (http.Header, error) {
+		if ctx.Err() != nil {
+			return nil, ctx.Err()
+		}
+		value, err := auth(proxyURL)
+		if err != nil {
+			return nil, safeConnectError(ctx, "proxy authentication", err)
+		}
+		if value == "" {
+			return nil, nil
+		}
+		return http.Header{"Proxy-Authorization": []string{value}}, nil
+	}
+}
+
+type websocketConn struct {
+	net.Conn
+	ws   *websocket.Conn
+	once sync.Once
+	err  error
+}
+
+func (c *websocketConn) Close() error {
+	c.once.Do(func() {
+		// NetConn.Close waits for a WebSocket close handshake. A stalled
+		// relay must not extend the connection-establishment deadline.
+		c.err = c.ws.CloseNow()
+		_ = c.Conn.Close()
+	})
+	if errors.Is(c.err, net.ErrClosed) {
+		return nil
 	}
-	// log.Printf("websocket: connected to %v", urlStr)
-	netConn := websocket.NetConn(context.Background(), c, websocket.MessageBinary)
-	return netConn, nil
+	return c.err
 }
