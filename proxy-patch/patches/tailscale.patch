+
+func TestProxyConnectionDiagnostics(t *testing.T) {
+	t.Parallel()
+	for _, tc := range []struct {
+		name string
+		err  error
+		want string
+	}{
+		{"TLS wrapper", &tls.CertificateVerificationError{Err: errors.New("fixture-secret")}, "TLS verification"},
+		{"unknown authority", x509.UnknownAuthorityError{}, "TLS verification"},
+		{"hostname", x509.HostnameError{Host: "fixture-secret"}, "TLS verification"},
+		{"invalid certificate", x509.CertificateInvalidError{}, "TLS verification"},
+		{"DNS", &net.DNSError{Name: "fixture-secret", Err: "fixture-secret"}, "DNS"},
+		{"refused", syscall.ECONNREFUSED, "connection refused"},
+		{"deadline", os.ErrDeadlineExceeded, "timeout"},
+		{"unknown", errors.New("fixture-secret"), "proxy dial failed"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			err := safeConnectError(context.Background(), "proxy dial", fmt.Errorf("fixture-secret: %w", tc.err))
+			if !strings.Contains(err.Error(), tc.want) || strings.Contains(err.Error(), "fixture-secret") {
+				t.Fatal("safe diagnostic category missing or underlying text disclosed")
+			}
+		})
+	}
+}
+
+func TestProxyConnectionDeadlineRetainsCategory(t *testing.T) {
+	t.Parallel()
+	ctx, cancel := context.WithDeadline(context.Background(), time.Unix(1, 0))
+	defer cancel()
+	err := safeConnectError(ctx, "proxy dial", &net.DNSError{Name: "fixture-secret"})
+	if !errors.Is(err, context.DeadlineExceeded) || !strings.Contains(err.Error(), "DNS") || strings.Contains(err.Error(), "fixture-secret") {
+		t.Fatal("deadline lost identity or safe cause category")
+	}
+}
+
+func TestProxyConnectionRegionDiagnostic(t *testing.T) {
+	t.Parallel()
+	region := &tailcfg.DERPRegion{RegionID: 17, RegionCode: "fixture-secret"}
+	var logMu sync.Mutex
+	var logs strings.Builder
+	c := NewRegionClient(key.NewNode(), func(format string, args ...any) {
+		logMu.Lock()
+		defer logMu.Unlock()
+		fmt.Fprintf(&logs, format, args...)
+	}, nil, func() *tailcfg.DERPRegion { return region })
+	defer c.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	err := c.Connect(ctx)
+	logMu.Lock()
+	defer logMu.Unlock()
+	if !strings.Contains(logs.String(), "connecting to derp-17") || strings.Contains(logs.String(), "fixture-secret") {
+		t.Fatal("numeric region log missing or remote region text disclosed in diagnostics")
+	}
+	if err == nil || !strings.Contains(err.Error(), "derp-17") || strings.Contains(err.Error(), "fixture-secret") {
+		t.Fatal("numeric region context missing or remote region text disclosed")
+	}
+}
