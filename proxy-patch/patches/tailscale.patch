+		{name: "http", target: "ws://relay.test/derp", env: map[string]string{"HTTPS_PROXY": "http://secure-proxy.test:8080", "HTTP_PROXY": "http://plain-proxy.test:8080"}, want: "plain-proxy.test:8080"},
+		{name: "lowercase", target: "https://relay.test/derp", env: map[string]string{"https_proxy": "http://lower-proxy.test:8080"}, want: "lower-proxy.test:8080"},
+		{name: "case_conflict", target: "https://relay.test/derp", env: map[string]string{"HTTPS_PROXY": "http://upper-proxy.test:8080", "https_proxy": "http://lower-proxy.test:8080"}, want: "lower-proxy.test:8080"},
+		{name: "all_proxy_unchanged", target: "https://relay.test/derp", env: map[string]string{"ALL_PROXY": "http://unused-proxy.test:8080"}},
+		{name: "domain_bypass", target: "https://relay.test/derp", env: map[string]string{"HTTPS_PROXY": "http://proxy.test:8080", "NO_PROXY": "relay.test"}},
+		{name: "suffix_bypass", target: "https://relay.test/derp", env: map[string]string{"HTTPS_PROXY": "http://proxy.test:8080", "NO_PROXY": ".test"}},
+		{name: "ip_bypass", target: "https://192.0.2.1/derp", env: map[string]string{"HTTPS_PROXY": "http://proxy.test:8080", "NO_PROXY": "192.0.2.1"}},
+		{name: "cidr_bypass", target: "https://192.0.2.1/derp", env: map[string]string{"HTTPS_PROXY": "http://proxy.test:8080", "NO_PROXY": "192.0.2.0/24"}},
+		{name: "port_bypass", target: "https://relay.test:8443/derp", env: map[string]string{"HTTPS_PROXY": "http://proxy.test:8080", "NO_PROXY": "relay.test:8443"}},
+		{name: "port_mismatch", target: "https://relay.test:8443/derp", env: map[string]string{"HTTPS_PROXY": "http://proxy.test:8080", "NO_PROXY": "relay.test:443"}, want: "proxy.test:8080"},
+		{name: "wildcard_bypass", target: "https://relay.test/derp", env: map[string]string{"HTTPS_PROXY": "http://proxy.test:8080", "NO_PROXY": "*"}},
+		{name: "lowercase_no_proxy_wins", target: "https://relay.test/derp", env: map[string]string{"HTTPS_PROXY": "http://proxy.test:8080", "NO_PROXY": "other.test", "no_proxy": "relay.test"}},
+		{name: "cgi_error", target: "http://relay.test/derp", env: map[string]string{"HTTP_PROXY": "http://proxy.test:8080", "REQUEST_METHOD": "GET"}, wantError: true},
+		{name: "unsupported_scheme", target: "https://relay.test/derp", env: map[string]string{"HTTPS_PROXY": "socks5://proxy.test:1080"}, wantError: true},
