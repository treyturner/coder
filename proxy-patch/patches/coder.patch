+package cli_test
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"os"
+	"os/exec"
+	"strings"
+	"sync/atomic"
+	"testing"
+
+	"github.com/coder/coder/v2/cli/clitest"
+	"github.com/coder/coder/v2/codersdk"
+	"github.com/coder/coder/v2/testutil"
+)
+
+func TestProxySSHDisabledAutostart(t *testing.T) {
+	t.Parallel()
+	if os.Getenv("CODER_PROXY_CLI_FIXTURE") != "1" {
+		ctx, cancel := context.WithTimeout(context.Background(), testutil.WaitSuperLong)
+		defer cancel()
+		//nolint:gosec // This binary and constant selectors are test-controlled.
+		cmd := exec.CommandContext(ctx, os.Args[0], "-test.run=^TestProxySSHDisabledAutostart$", "-test.timeout=30s")
+		cmd.Env = []string{"CODER_PROXY_CLI_FIXTURE=1", "GOTRACEBACK=none"}
+		out, err := cmd.CombinedOutput()
+		if strings.Contains(string(out), "fixture-secret") {
+			t.Fatal("synthetic credential escaped the CLI fixture")
+		}
+		if err != nil {
+			t.Fatalf("isolated CLI fixture failed: %s", out)
+		}
+		return
+	}
+	var lookups, mutations atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet {
+			mutations.Add(1)
+			w.WriteHeader(http.StatusMethodNotAllowed)
+			return
+		}
+		if r.Header.Get(codersdk.SessionTokenHeader) != "fixture-secret-session" {
+			t.Error("CLI fixture missing session authentication")
+		}
+		w.Header().Set("Content-Type", "application/json")
+		switch r.URL.Path {
+		case "/api/v2/appearance":
+			_ = json.NewEncoder(w).Encode(codersdk.AppearanceConfig{})
+		case "/api/v2/users/fixture/workspace/fixture":
+			lookups.Add(1)
+			_ = json.NewEncoder(w).Encode(codersdk.Workspace{Name: "fixture", LatestBuild: codersdk.WorkspaceBuild{
+				Transition: codersdk.WorkspaceTransitionStop, Status: codersdk.WorkspaceStatusStopped,
+			}})
+		default:
+			t.Error("unexpected CLI fixture API request")
+			w.WriteHeader(http.StatusNotFound)
+		}
+	}))
+	defer server.Close()
+	u, err := url.Parse(server.URL)
+	if err != nil {
+		t.Fatal("invalid local fixture URL")
+	}
+	client := codersdk.New(u, codersdk.WithSessionToken("fixture-secret-session"))
+	inv, root := clitest.New(t, "--disable-direct-connections", "ssh", "--disable-autostart", "--wait=no", "fixture/fixture", "--", "id", "-un")
+	clitest.SetupConfig(t, client, root)
+	var output bytes.Buffer
+	inv.Stdout, inv.Stderr = &output, &output
+	ctx, cancel := context.WithTimeout(context.Background(), testutil.WaitShort)
+	defer cancel()
+	err = inv.WithContext(ctx).Run()
+	if err == nil || !strings.Contains(err.Error(), "workspace must be started") || lookups.Load() != 1 || mutations.Load() != 0 {
+		t.Fatal("disabled autostart did not reject the stopped workspace without mutations")
+	}
+	if strings.Contains(output.String(), "fixture-secret") || strings.Contains(err.Error(), "fixture-secret") {
+		t.Error("CLI fixture disclosed synthetic authentication")
+	}
+}
