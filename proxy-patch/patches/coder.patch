+package cli
+
+import (
+	"context"
+	"os"
+	"os/exec"
+	"strings"
+	"testing"
+
+	"github.com/coder/coder/v2/testutil"
+)
+
+func TestProxyCLIEnvironmentGuard(t *testing.T) {
+	t.Parallel()
+	if os.Getenv("CODER_PROXY_ENV_FIXTURE") == "1" {
+		// The client must fail before headers, version checks, or API dialing.
+		_, err := (&RootCmd{}).createHTTPClient(context.Background(), nil, nil)
+		if err == nil || !strings.Contains(err.Error(), "conflicting proxy environment") || strings.Contains(err.Error(), "fixture-secret") {
+			t.Fatal("client configuration did not reject ambiguous proxy settings safely")
+		}
+		return
+	}
+	for _, name := range []string{"HTTP_PROXY", "HTTPS_PROXY", "NO_PROXY"} {
+		t.Run(name, func(t *testing.T) {
+			t.Parallel()
+			ctx, cancel := context.WithTimeout(context.Background(), testutil.WaitLong)
+			defer cancel()
+			//nolint:gosec // This binary and constant selectors are test-controlled.
+			cmd := exec.CommandContext(ctx, os.Args[0], "-test.run=^TestProxyCLIEnvironmentGuard$", "-test.timeout=10s")
+			cmd.Env = []string{"CODER_PROXY_ENV_FIXTURE=1", "GOTRACEBACK=none", name + "=fixture-secret-upper", strings.ToLower(name) + "=fixture-secret-lower"}
+			output, err := cmd.CombinedOutput()
+			if err != nil || strings.Contains(string(output), "fixture-secret") {
+				t.Fatal("isolated CLI proxy guard failed or disclosed a setting")
+			}
+		})
+	}
+}
